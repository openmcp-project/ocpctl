{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>openmcp-project/.github:renovate-config"
  ],
  "packageRules": [
    {
      "description": "Automerge non-major updates for stable packages",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "Automerge patch updates for kubernetes ecosystem packages",
      "matchPackagePrefixes": ["k8s.io/", "sigs.k8s.io/"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Automerge patch updates for cluster-provider-kind",
      "matchPackageNames": ["github.com/openmcp-project/cluster-provider-kind"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Group all updates for environment-defaults.yaml",
      "matchFileNames": ["/^pkg/config/environment-defaults\\.yaml$/"],
      "groupName": "environment-defaults updates",
      "groupSlug": "environment-defaults-updates",
      "separateMajorMinor": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^pkg/config/environment-defaults\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) registryUrl=(?<registryUrl>\\S+) depName=(?<depName>\\S+)(?<newline>\\s+)image: [^:]+:(?<currentValue>\\S+)"
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{datasource}} depName={{depName}}{{newline}}image: {{{depName}}}:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}"
    }
  ]
}
