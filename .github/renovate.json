{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>openmcp-project/.github:renovate-config",
    "config:best-practices"
  ],
  "packageRules": [
    {
      "description": "Group all updates for environment-defaults.yaml",
      "matchFileNames": ["/^pkg/config/environment-defaults\\.yaml$/"],
      "groupName": "environment-defaults updates",
      "groupSlug": "environment-defaults-updates",
      "separateMajorMinor": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^pkg/config/environment-defaults\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) registryUrl=(?<registryUrl>\\S+) depName=(?<depName>\\S+)(?<newline>\\s+)image: [^:]+:(?<currentValue>\\S+)"
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{datasource}} depName={{depName}}{{newline}}image: {{{depName}}}:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}"
    }
  ]
}
