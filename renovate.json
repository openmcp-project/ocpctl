{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^pkg/config/environment-defaults\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?<newline>\\s+)image: [^:]+:(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>\\S+))?"
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{datasource}} depName={{depName}}{{newline}}image: {{{depName}}}:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}"
    }
  ]
}
